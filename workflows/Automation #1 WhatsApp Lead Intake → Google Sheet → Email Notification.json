    {
      "parameters": {
        "jsCode": "const msg = String($json.message ?? \"\")\n  .toLowerCase()\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nconst pricingRe = /\\b(price|pricing|cost|fee)\\b|\\bhow much\\b/;\nconst bookingRe = /\\b(book|booking|appointment|schedule|available|visit)\\b/;\n\nlet category = \"general\";\nif (pricingRe.test(msg)) category = \"pricing\";\nelse if (bookingRe.test(msg)) category = \"booking\";\n\nreturn {\n  ...$json,\n  category,\n};\n"
      },
