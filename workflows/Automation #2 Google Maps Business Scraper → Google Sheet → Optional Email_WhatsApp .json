    },
    {
      "parameters": {
        "jsCode": "const res = items[0].json;\nif (!res.results || res.results.length === 0) {\n  throw new Error(\"Geocode returned no results. Check location string.\");\n}\nconst loc = res.results[0].geometry.location;\nreturn [{ json: { ...items[0].json, lat: loc.lat, lng: loc.lng } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "a2d9dbae-a91d-4347-a6f9-a859a1a02dfa",
      "name": "Extract LatLng"
    },
    {
      "parameters": {
        "url": "https://maps.googleapis.com/maps/api/place/textsearch/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{$node[\"Inputs\"].json.query}}\n"
            },
