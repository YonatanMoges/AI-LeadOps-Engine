      "typeVersion": 4.3,
      "position": [
        832,
        0
      ],
      "id": "75ce110a-f89e-4bbf-8858-cee6c86d3b80",
      "name": "Places Search"
    },
    {
      "parameters": {
        "jsCode": "const res = items[0].json;\nconst places = res.results || [];\nconst next = res.next_page_token || null;\n\nreturn places.map(p => ({\n  json: {\n    place_id: p.place_id,\n    name: p.name,\n    address: p.formatted_address,\n    rating: p.rating ?? null,\n    user_ratings_total: p.user_ratings_total ?? null,\n    types: p.types ?? [],\n    next_page_token: next\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "4c83f703-7870-47d2-9fef-3025535cfd6e",
      "name": "Extract Places + Token"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const d = item.json;\n\n  const rawPhone =\n    d.internationalPhoneNumber ||\n    d.nationalPhoneNumber ||\n    null;\n\n  const phone = rawPhone\n    ? rawPhone.replace(/\\s+/g, \"\").replace(/^\\+/, \"\")\n    : null;\n\n  const opening_hours = d.regularOpeningHours?.weekdayDescriptions\n    ? d.regularOpeningHours.weekdayDescriptions.join(\" | \")\n    : null;\n\n  const hasPhone = !!phone;\n  const hasWebsite = !!d.websiteUri;\n  const isOperational = d.businessStatus === \"OPERATIONAL\";\n  const openNow = d.regularOpeningHours?.openNow === true;\n\n  let lead_score = 0;\n\n  if (hasPhone) lead_score += 1;\n  if (hasWebsite) lead_score += 1;\n  if (isOperational) lead_score += 1;\n  if (openNow) lead_score += 1;\n\n  const nameText = (d.displayName?.text || \"\").toLowerCase();\n\n  if (\n    nameText.includes(\"clinic\") ||\n    nameText.includes(\"center\") ||\n    nameText.includes(\"centre\") ||\n    nameText.includes(\"medical\")\n  ) {\n    lead_score += 1;\n  }\n\n  lead_score = Math.min(lead_score, 5);\n\n  return {\n    json: {\n      name: d.displayName?.text || null,\n      phone,\n      address: d.formattedAddress || null,\n      website: d.websiteUri || null,\n      business_status: d.businessStatus || null,\n\n      source: \"Google Maps\",\n\n      niche: \"Dental Clinic\",\n      city: \"Sharjah\",\n      country: \"UAE\",\n\n      lead_score,\n      has_phone: hasPhone,\n      has_website: hasWebsite,\n      is_operational: isOperational,\n\n      last_seen_at: new Date().toISOString(),\n      created_at: new Date().toISOString(),\n\n      open_now: openNow,\n      opening_hours,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
        0
      ],
      "id": "5d953848-9802-4b24-9206-1923eb2b64d8",
      "name": "Normalize Leads"
    },
    {
      "parameters": {
        "jsCode": "const apiKey = $items(\"Inputs\")[0]?.json?.api_key;\nif (!apiKey) throw new Error(\"Inputs.api_key is empty\");\n\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    api_key: apiKey.trim(),\n  }\n}));\n"
      },
