      "id": "8991db31-a3fd-44c7-9d69-4b4c73616dd6",
      "name": "Send a message",
      "webhookId": "55b388bc-12fb-4ebd-bd47-bc2fead3ee2f"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const name = $json.name || \"your business\";\nconst city = $json.city || \"your area\";\nconst niche = $json.niche || \"business\";\nconst website = $json.website;\nconst leadScore = Number($json.lead_score || 0);\nconst businessStatus = $json.business_status || \"\";\n\nlet insight = \"\";\n\nif (website && leadScore >= 4) {\n  insight = `I noticed ${name} has a strong online presence in ${city}, which usually means there is already good demand coming through digital channels.`;\n} else if (!website && leadScore >= 3) {\n  insight = `I noticed ${name} appears on Google Maps in ${city}, but I could not see a clear website or online booking flow.`;\n} else if (businessStatus === \"OPERATIONAL\") {\n  insight = `I noticed ${name} is currently active in ${city}, which makes it a good fit for improving lead response and follow-up.`;\n} else {\n  insight = `I came across ${name} while reviewing ${niche} businesses in ${city}.`;\n}\n\nconst message = `\nHi ${name},\n\n${insight}\n\nI help ${niche.toLowerCase()} businesses automate lead handling, follow-ups, and customer response workflows so inquiries do not get missed.\n\nWould you be open to a quick discussion?\n\nBest regards,\nYour Name\n`;\n\nreturn {\n  json: {\n    ...$json,\n    status: \"contacted\",\n    priority: leadScore >= 4 ? \"High\" : leadScore >= 3 ? \"Medium\" : \"Low\",\n    contacted_at: new Date().toISOString(),\n    follow_up_message: message.trim(),\n    next_action: \"manual_review\",\n\n    lead_stage: \"waiting_reply\",\n    follow_up_attempts: Number($json.follow_up_attempts || 0) + 1,\n    last_contacted_at: new Date().toISOString(),\n    next_follow_up_at: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString(),\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        -96
      ],
      "id": "1d22af7f-d82b-4900-9f6d-d495b946277c",
      "name": "Generate Follow-Up Message"
    },
    {
      "parameters": {
        "jsCode": "const score = $json.lead_score || 0;\n\nlet priority = \"Low\";\n\nif (score >= 4) {\n  priority = \"High\";\n} else if (score >= 3) {\n  priority = \"Medium\";\n}\n\nreturn [{\n  json: {\n    ...$json,\n    priority\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
