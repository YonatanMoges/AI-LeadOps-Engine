    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "New High Priority Lead",
        "message": "=Business: {{$json.name}}\n\nPriority: {{$json.priority}}\n\nPhone: {{$json.phone}}\n\nWebsite: {{$json.website}}\n\nMessage:\n{{$json.follow_up_message}}",
        "options": {}
